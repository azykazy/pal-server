#!/usr/bin/env bash
# Key Vault からシークレットを、Blob Storage からゲーム設定を取得し、
# docker compose 用の /opt/palworld/.env を生成する。
# VM の Managed Identity (IMDS) で認証するため、鍵やパスワードは VM イメージに焼き込まれない。
set -euo pipefail

VAULT_URL='${key_vault_uri}'
GAME_SETTINGS_BLOB_URL='${game_settings_blob_url}'

# ── Key Vault トークン ───────────────────────────────────────────
KV_TOKEN=$(curl -fsS --max-time 15 -H "Metadata: true" \
  "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net" \
  | jq -r .access_token)

get_secret() {
  curl -fsS --max-time 15 -H "Authorization: Bearer $KV_TOKEN" \
    "$${VAULT_URL}secrets/$1?api-version=7.4" | jq -r .value
}

set_secret() {
  local json
  json=$(jq -nc --arg v "$2" '{"value": $v}')
  curl -fsS --max-time 15 -X PUT \
    -H "Authorization: Bearer $KV_TOKEN" \
    -H "Content-Type: application/json" \
    -d "$json" \
    "$${VAULT_URL}secrets/$1?api-version=7.4" > /dev/null
}

# ── シークレット取得 ─────────────────────────────────────────────
# 起動のたびにランダムな6桁パスワードを生成して Key Vault を更新
SERVER_PASSWORD=$(openssl rand -hex 40 | tr -dc '0-9' | cut -c1-6)
set_secret server-password "$SERVER_PASSWORD"

ADMIN_PASSWORD=$(get_secret admin-password)
DISCORD_WEBHOOK_URL=$(get_secret discord-webhook-url || true)
INTERNAL_STOP_URL=$(get_secret internal-stop-url || true)
SERVER_NAME=$(get_secret server-name || true)
COMMUNITY=$(get_secret community-mode || echo "false")

PUBLIC_IP=$(curl -fsS --max-time 10 -H "Metadata: true" \
  "http://169.254.169.254/metadata/instance/network/interface/0/ipv4/ipAddress/0/publicIpAddress?api-version=2021-02-01&format=text" 2>/dev/null || true)
if [ -z "$PUBLIC_IP" ]; then
  echo "warn: IMDS から PUBLIC_IP を取得できませんでした。Community Mode 非使用時は影響なし。" >&2
fi

umask 077
# printf '%q' でシェルセーフなクォーティングを行いインジェクションを防止
{
  printf 'SERVER_PASSWORD=%q\n'     "$SERVER_PASSWORD"
  printf 'ADMIN_PASSWORD=%q\n'      "$ADMIN_PASSWORD"
  printf 'DISCORD_WEBHOOK_URL=%q\n' "$DISCORD_WEBHOOK_URL"
  printf 'INTERNAL_STOP_URL=%q\n'   "$INTERNAL_STOP_URL"
  printf 'STORAGE_ACCOUNT=%q\n'     '${storage_account_name}'
  printf 'SERVER_NAME=%q\n'         "$SERVER_NAME"
  printf 'COMMUNITY=%q\n'           "$COMMUNITY"
  printf 'PUBLIC_IP=%q\n'           "$PUBLIC_IP"
} > /opt/palworld/.env

# ── ゲーム設定を Blob Storage から取得 ──────────────────────────
STORAGE_TOKEN=$(curl -fsS --max-time 15 -H "Metadata: true" \
  "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fstorage.azure.com" \
  | jq -r .access_token)

GAME_SETTINGS_TMP=$(mktemp)
if curl -fsS --max-time 15 \
    -H "Authorization: Bearer $STORAGE_TOKEN" \
    -H "x-ms-version: 2020-10-02" \
    "$GAME_SETTINGS_BLOB_URL" -o "$GAME_SETTINGS_TMP"; then
  # シークレット系キーによる上書きを防ぐ: Key Vault から取得した値が無効化されないよう検証する
  BLOCKED_KEYS="ADMIN_PASSWORD|SERVER_PASSWORD|INTERNAL_STOP_URL|DISCORD_WEBHOOK_URL"
  if grep -qP "^\s*($${BLOCKED_KEYS})\s*=" "$GAME_SETTINGS_TMP" 2>/dev/null; then
    echo "game-settings にシークレット系キーが含まれているため読み込みをスキップします" >&2
  else
    cat "$GAME_SETTINGS_TMP" >> /opt/palworld/.env
    echo "game-settings loaded from blob"
  fi
  rm -f "$GAME_SETTINGS_TMP"
else
  rm -f "$GAME_SETTINGS_TMP"
  echo "game-settings blob not found; docker-compose defaults will be used"
fi

echo "secrets fetched to /opt/palworld/.env"
